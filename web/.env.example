# Start with npm run setup:demo. Secrets generated there are ignored by Git.
VOXA_DEMO_MODE=false
APP_URL=http://127.0.0.1:3000
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VOXA_SESSION_SECRET=
VOXA_LICENSE_KEY_ID=production-v1
VOXA_LICENSE_PRIVATE_KEY=
VOXA_LICENSE_PUBLIC_KEYS={}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only currencies/prices configured in your merchant account.
STRIPE_PRICE_FAMILY_PRO_EGP_MONTHLY=
STRIPE_PRICE_FAMILY_PRO_EGP_ANNUAL=
STRIPE_PRICE_FAMILY_PRO_SAR_MONTHLY=
STRIPE_PRICE_FAMILY_PRO_SAR_ANNUAL=
STRIPE_PRICE_CLINICAL_SLP_EGP_MONTHLY=
STRIPE_PRICE_CLINICAL_SLP_SAR_MONTHLY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
# Optional transactional fulfillment email (a verified sender domain is required).
RESEND_API_KEY=
VOXA_FROM_EMAIL=
# Optional Android download URL; otherwise the CTA explains build availability.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
