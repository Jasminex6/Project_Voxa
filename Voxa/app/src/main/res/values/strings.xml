    <!-- Onboarding Screen -->
    <string name="onboarding_welcome_title">Welcome to Voxa</string>
    <string name="onboarding_welcome_desc">Voxa is an inclusive AI assistant designed to translate non-verbal vocalizations of children into speech, helping them communicate their needs effortlessly.</string>
    <string name="onboarding_concept_title">How it Works</string>
    <string name="onboarding_concept_desc">Parents enroll custom sounds (like \'ah\' for water). Voxa runs in the background, detects these vocalizations, and plays translations or alerts caregivers.</string>
