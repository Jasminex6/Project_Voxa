    <!-- Onboarding Walkthrough -->
    <string name="onboarding_title_1">Welcome to Voxa</string>
    <string name="onboarding_desc_1">Voxa translates your child\'s unique vocalizations into clear Egyptian Arabic voice output, helping them communicate their needs instantly.</string>
    <string name="onboarding_title_2">Personalized Translation</string>
    <string name="onboarding_desc_2">Caregivers record custom sound templates (e.g. custom hums or sounds) and pair them with standard meanings. Voxa uses offline similarity matching to recognize them.</string>
    <string name="onboarding_title_3">System Permissions</string>
    <string name="onboarding_desc_3">To monitor speech and notify you, Voxa requires Microphone, Notification, and GPS permissions. All audio is processed locally and never leaves this device.</string>
    <string name="onboarding_title_4">Create First Profile</string>
    <string name="onboarding_desc_4">Let\'s get started by creating a profile for your child. Enter their name and select a voice pack matching their gender.</string>
